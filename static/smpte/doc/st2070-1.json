{"id":"st2070-1","designation":"ST 2070-1","title":"Stereoscopic 3D in MXF — Common Provisions","state":"active","suite":"2070","official":{"family_url":"https://pub.smpte.org/doc/st2070-1/","latest_url":"https://pub.smpte.org/latest/st2070-1/","checked_at":"2026-11-18"},"scope":"This document is the first part of a multipart document set that defines metadata and index structure of stereoscopic 3D video streams in MXF for operational applications. This document covers the common provisions that are required by this family of standards. This standard currently supports streams of stereoscopic images, either as uncompressed image pairs, intra- or inter-frame compressed formats.","outline":[],"definitions":[],"keywords":[{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Interoperable Master Format","zh":"可互操作母版格式","abbr":"IMF","category":"mastering","source":"curated"}],"refs":[{"id":"st2063","designation":"ST 2063"},{"id":"st377-1","designation":"ST 377-1"},{"id":"st377-2","designation":"ST 377-2"},{"id":"st400","designation":"ST 400"},{"id":"st298","designation":"ST 298"},{"id":"rp210","designation":"RP 210"},{"id":"rp224","designation":"RP 224"},{"id":"st429-10","designation":"ST 429-10"},{"id":"st2067-2","designation":"ST 2067-2"}],"cited_by":[{"id":"st2070-2","designation":"ST 2070-2"},{"id":"st2070-3","designation":"ST 2070-3"}],"versions":[{"version":"20140513-pub","date":"2014-05-13","kind":"publication","official_url":"https://pub.smpte.org/doc/st2070-1/20140513-pub/","present_locally":true}],"pages":7,"scanned":false,"ocr":false}