{"id":"rp155","designation":"RP 155","title":"Reference Levels for Analog and Digital Audio Systems","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/rp155/","latest_url":"https://pub.smpte.org/latest/rp155/","checked_at":"2026-11-18"},"scope":"This document provides Recommendations for the level of reference signals that facilitate the interchange of audio content on analog, digital or photographic media, and for the calibration of audio level indicators and other devices. The reference levels described by this Recommended Practice are not related to the subjective loudness of any audio content that they may be associated with.","outline":[],"definitions":[],"keywords":[{"term":"Analog Television Recording","zh":"模拟电视录制","abbr":"","category":"tv","source":"curated"},{"term":"Calibration","zh":"校准","abbr":"","category":"measurement","source":"curated"},{"term":"Release Print","zh":"发行拷贝","abbr":"","category":"film","source":"curated"},{"term":"Photographic Audio","zh":"感光录音","abbr":"","category":"audio","source":"curated"},{"term":"Loudness","zh":"响度","abbr":"","category":"audio","source":"curated"}],"refs":[{"id":"st40","designation":"ST 40"},{"id":"st41","designation":"ST 41"},{"id":"st203","designation":"ST 203"},{"id":"st183","designation":"ST 183"}],"cited_by":[{"id":"rp428-6","designation":"RP 428-6"},{"id":"st252","designation":"ST 252"},{"id":"st264","designation":"ST 264"},{"id":"st265","designation":"ST 265"},{"id":"st323","designation":"ST 323"}],"versions":[{"version":"20141113-pub","date":"2014-11-13","kind":"publication","official_url":"https://pub.smpte.org/doc/rp155/20141113-pub/","present_locally":true},{"version":"20040810-pub","date":"2004-08-10","kind":"publication","official_url":"https://pub.smpte.org/doc/rp155/20040810-pub/","present_locally":true}],"pages":7,"scanned":false,"ocr":false}