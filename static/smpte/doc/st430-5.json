{"id":"st430-5","designation":"ST 430-5","title":"D-Cinema Operations — Security Log Event Class and Constraints","state":"active","suite":"430","official":{"family_url":"https://pub.smpte.org/doc/st430-5/","latest_url":"https://pub.smpte.org/latest/st430-5/","checked_at":"2026-11-18"},"scope":"The purpose of this document is to specify a Security Event Class and namespace for Security Log Records; and to constrain individual Log Records and sequences of such records (Log Reports) as they are used for security event logging purposes in D-Cinema applications. The items covered contain descriptions of events logged by the security system, which are intended to provide forensic information regarding security-critical events. This document does not specify the means of communication or the format of messaging between security devices in a system. Neither does this document define the format for storage of Log Events within the protected storage of a security device. The Security Log Records and Security Log Record Sequences (Log Reports) described herein are intended for reporting of Security Events previously recorded by the security system to consumers of that information which are external to the security system.","outline":[{"level":1,"title":"D-Cinema Operations — Security Log Event Class and Constraints","page":1},{"level":2,"title":"Table of contents","page":1},{"level":2,"title":"Foreword","page":1},{"level":2,"title":"Introduction","page":1},{"level":2,"title":"1Scope","page":1},{"level":2,"title":"2Conformance","page":1},{"level":2,"title":"3Normative references","page":1},{"level":2,"title":"4Terms and definitions","page":1},{"level":2,"title":"5Overview (Informative)","page":1},{"level":2,"title":"6Definitions","page":1},{"level":3,"title":"6.1Terms","page":1},{"level":3,"title":"6.2 Processes and Validation","page":1},{"level":3,"title":"6.3Security Event Class","page":1},{"level":3,"title":"6.4 Security Class Namespace","page":1},{"level":3,"title":"6.5Namespace Prefixes","page":1},{"level":3,"title":"6.6Reference Architectures","page":1},{"level":2,"title":"7Security Application Requirements","page":1},{"level":3,"title":"7.1Overview","page":1},{"level":3,"title":"7.2Security Constraints","page":1},{"level":3,"title":"7.3Security Log Record Authentication and Chaining","page":1},{"level":2,"title":"8Security Event Definitions","page":1},{"level":3,"title":"8.1General","page":1},{"level":3,"title":"8.2ReferencedID Scope","page":1},{"level":3,"title":"8.3Event Types","page":1},{"level":3,"title":"8.4Event SubTypes","page":1},{"level":3,"title":"8.5Exception Tokens and Definitions","page":1},{"level":2,"title":"9Example","page":1},{"level":2,"title":"Annex A Proxy Logging (Informative)","page":1},{"level":2,"title":"Annex B Security Log Report Filtering (Informative)","page":1},{"level":2,"title":"Additional elements","page":1}],"definitions":[],"keywords":[{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Encryption","zh":"加密","abbr":"","category":"cinema","source":"curated"},{"term":"Composition Playlist","zh":"合成播放列表","abbr":"CPL","category":"cinema","source":"curated"},{"term":"Immersive Audio","zh":"沉浸式音频","abbr":"","category":"audio","source":"curated"},{"term":"Forensic Marking","zh":" forensic 标记","abbr":"","category":"cinema","source":"curated"},{"term":"Key Delivery Message","zh":"密钥分发消息","abbr":"KDM","category":"cinema","source":"curated"},{"term":"SHA","zh":"","abbr":"SHA","category":"other","source":"acronym"}],"refs":[{"id":"st430-4","designation":"ST 430-4"},{"id":"st433","designation":"ST 433"},{"id":"st430-1","designation":"ST 430-1"},{"id":"st430-2","designation":"ST 430-2"},{"id":"st430-6","designation":"ST 430-6"},{"id":"st429-3","designation":"ST 429-3"},{"id":"st429-6","designation":"ST 429-6"},{"id":"st429-5","designation":"ST 429-5"},{"id":"s