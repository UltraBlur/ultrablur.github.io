{"id":"st2113","designation":"ST 2113","title":"Colorimetry of P3 Color Spaces","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st2113/","latest_url":"https://pub.smpte.org/latest/st2113/","checked_at":"2026-11-18"},"scope":"This standard defines the colorimetry (color primaries and white points) of P3 RGB color spaces. It also specifies metadata items including SMPTE Universal Labels which identify each RGB colorimetry. These metadata items are for use in files or encodings. It does not define a color space encoding.","outline":[{"level":1,"title":"1 Scope","page":3},{"level":1,"title":"2 Conformance Notation","page":3},{"level":1,"title":"3 Normative References","page":4},{"level":1,"title":"4 Terms and Definitions","page":4},{"level":2,"title":"4.1 white point","page":4},{"level":2,"title":"4.2 chromaticity coordinates","page":4},{"level":1,"title":"5 Colorimetry","page":4},{"level":2,"title":"5.1 P3 color primaries","page":4},{"level":1,"title":"6 Color Space Metadata Items","page":5},{"level":2,"title":"6.1 General","page":5},{"level":2,"title":"6.2 P3D65","page":5},{"level":2,"title":"6.3 P3D60","page":5},{"level":2,"title":"6.4 P3DCI","page":5},{"level":1,"title":"7 Universal Label (UL) for P3 Color Spaces","page":5},{"level":2,"title":"7.1 General","page":5},{"level":2,"title":"7.2 Label for P3D65","page":5},{"level":2,"title":"7.3 Label for P3D60","page":6},{"level":2,"title":"7.4 Label for P3DCI","page":6},{"level":1,"title":"8 Bibliography (informative)","page":6}],"definitions":[],"keywords":[{"term":"Chromaticity","zh":"色度","abbr":"","category":"measurement","source":"curated"},{"term":"ACES","zh":"ACES 色彩编码","abbr":"ACES","category":"aces","source":"curated"},{"term":"Digital Cinema Initiatives","zh":"数字影院倡议","abbr":"DCI","category":"cinema","source":"curated"},{"term":"RGB","zh":"","abbr":"RGB","category":"other","source":"acronym"}],"refs":[{"id":"st400","designation":"ST 400"},{"id":"rp431-2","designation":"RP 4