{"id":"st259","designation":"ST 259","title":"Television - SDTV Digital Signal/Data - Serial Digital Interface","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st259/","latest_url":"https://pub.smpte.org/latest/st259/","checked_at":"2026-11-11"},"scope":"This standard describes a 10-bit serial digital interface operating at 143/270/360 Mb/s. The serial interface may carry uncompressed SDTV signals, or data. This standard has application in the television studio over lengths of coaxial cable where the signal loss does not exceed an amount specified by the receiver manufacturer. Typical loss amounts may be in the range of 20 dB to 30 dB at one-half clock frequency with appropriate receiver equalization. Receivers designed to work with lesser signal attenuation are acceptable, but are not recommend for new designs.","outline":[],"definitions":[],"keywords":[{"term":"NTSC","zh":"NTSC 制式","abbr":"","category":"tv","source":"curated"},{"term":"Connector","zh":"连接器","abbr":"","category":"tv","source":"curated"},{"term":"Audio Polarity","zh":"音频极性","abbr":"","category":"audio","source":"curated"},{"term":"Test Pattern","zh":"测试图","abbr":"","category":"measurement","source":"curated"},{"term":"PAL","zh":"PAL 制式","abbr":"","category":"tv","source":"curated"},{"term":"Perceptual Quantizer","zh":"感知量化","abbr":"PQ","category":"hdr","source":"curated"},{"term":"TRS","zh":"","abbr":"TRS","category":"other","source":"acronym"}],"refs":[{"id":"rp184","designation":"RP 184"},{"id":"rp165","designation":"RP 165"}],"cited_by":[{"id":"eg2069","designation":"EG 2069"},{"id":"eg2111-1","designation":"EG 2111-1"},{"id":"ov292-0","designation":"OV 292-0"},{"id":"ov297-0","designation":"OV 297-0"},{"id":"rp184","designation":"RP 184"},{"id":"rp192","designation":"RP 192"},{"id":"rp2091-2","designation":"RP 2091-2"},{"id":"rp2129","designation":"RP 2129"},{"id":"st125","designation":"ST 125"},{"id":"st2022-6","designation":"ST 2022-6"},{"id":"st2042-2","d