{"id":"st2022-6","designation":"ST 2022-6","title":"MPEG-2 Streams on IP Networks — Transport of High Bit Rate Media Signals over IP Networks (HBRMT)","state":"active","suite":"2022","official":{"family_url":"https://pub.smpte.org/doc/st2022-6/","latest_url":"https://pub.smpte.org/latest/st2022-6/","checked_at":"2026-11-11"},"scope":"This standard defines a unidirectional IP-based protocol for the transport of real-time video, audio, and ancillary signals. In particular this standard defines a method for the encapsulation of the payloads of a variety of existing SMPTE serial digital video standards. The term High Bit Rate is used herein to distinguish from other Media-over-IP applications in which compressed signals are transported. The uncompressed signals in this document are at rates of 270 Mbits/sec and higher.","outline":[{"level":1,"title":"1","page":3},{"level":1,"title":"1","page":3},{"level":1,"title":"1","page":3},{"level":1,"title":"1 Scope","page":3},{"level":1,"title":"2 Conformance Notation","page":3},{"level":1,"title":"3 Normative References","page":3},{"level":1,"title":"4 Acronyms","page":4},{"level":1,"title":"5 Definitions","page":5},{"level":1,"title":"1","page":6},{"level":1,"title":"6 User Performance Requirements","page":6},{"level":2,"title":"6.1 Basic Network Requirements","page":6},{"level":2,"title":"6.2 Media Datagram Description","page":6},{"level":2,"title":"1.1","page":6},{"level":2,"title":"6.3 RTP/UDP/IP Header","page":6},{"level":2,"title":"6.4 High Bit Rate Media Payload Header","page":8},{"level":2,"title":"6.5 High Bit Rate Media Payload","page":12},{"level":1,"title":"7 FEC Interoperability and Usage","page":14},{"level":2,"title":"7.1 FEC Interoperability","page":14},{"level":2,"title":"7.2 Network Consideration (Informative)","page":14},{"level":1,"title":"Annex A Bibliography (Informative)","page":16}],"definitions":[],"keywords":[{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curate