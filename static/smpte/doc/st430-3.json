{"id":"st430-3","designation":"ST 430-3","title":"D-Cinema Operations — Generic Extra-Theater Message Format","state":"active","suite":"430","official":{"family_url":"https://pub.smpte.org/doc/st430-3/","latest_url":"https://pub.smpte.org/latest/st430-3/","checked_at":"2026-11-11"},"scope":"This standard presents a specification for a generic Extra-Theatre Message (ETM) format for use with unidirectional communications channels used in security communcations for Digital Cinema (D-Cinema) systems. The ETM specification is a generic XML security wrapper that includes specific fields which can be extended to carry different kinds of information to meet various application-level requirements. (For example, the Key Delivery Message (KDM) is a specific instance of this format.) The ETM uses W3C Extensible Markup Language (see [XML]) to represent the information payload. It provides security using the XML encryption and signature primitives. Note: The brackets convention “[…]” as used herein denotes either a normative or informative reference.","outline":[{"level":1,"title":"SMPTE ST 430-3:2012","page":1},{"level":1,"title":"Revision of","page":1},{"level":1,"title":"SMPTE 430-3-2008","page":1},{"level":1,"title":"6.2 MessageType","page":7},{"level":1,"title":"6.3 AnnotationText","page":7},{"level":1,"title":"6.4 IssueDate","page":8},{"level":1,"title":"6.5 Signer","page":8},{"level":1,"title":"6.6 RequiredExtentions (Optional)","page":8},{"level":1,"title":"6.7 NonCriticalExtensions (Optional)","page":8},{"level":1,"title":"7.1 EncryptedKey","page":9},{"level":2,"title":"7.1.1 EncryptionMethod","page":9},{"level":2,"title":"7.1.2 KeyInfo","page":10},{"level":2,"title":"7.1.3 CipherData","page":10},{"level":2,"title":"7.1.4 EncryptionProperties","page":10},{"level":2,"title":"7.1.5 ReferenceList","page":10},{"level":2,"title":"7.1.6 CarriedKeyName","page":10},{"level":1,"title":"7.2 EncryptedData (Optional)","page":10},{"level":1,"title":"8.2 SignedInfo","page":13},{"level":1,"title":"8.3 SignatureValue","page":14},{"level":1,"title":"8.4 KeyInfo Certificate Chain","page":14},{"level":1,"title":"8.5 Object Information","page":14},{"level":1,"title":"Examples","page":20},{"level":1,"title":"Model symbols (\"compositors\")","page":21},{"level":1,"title":"Types","page":21},{"level":1,"title":"Model groups and references","page":21}],"definitions":[],"keywords":[{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"Encryption","zh":"加密","abbr":"","category":"cinema","source":"curated"},{"term":"Key Delivery Message","zh":"密钥分发消息","abbr":"KDM","category":"cinema","source":"curated"},{"term":"UTF","zh":"","abbr":"UTF","category":"other","source":"acronym"},{"term":"UTC","zh":"","abbr":"UTC","category":"other","source":"acronym"},{"term":"REC","zh":"","abbr":"REC","category":"other","source":"acronym"},{"term":"SHA","zh":"","abbr":"SHA","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"st430-1","designation":"ST 430-1"}],"versions":[{"version":"20120822-pub","date":"2012-08-22","kind":"publication","official_url":"https://pub.smpte.org/doc/st430-3/20120822-pub/","present_locally":true},{"version":"20120822-am2-pub","date":"2012-08-22","kind":"amendment","official_url":"https://pub.smpte.org/doc/st430-3/20120822-am2-pub/","present_locally":true},{"version":"20080303-pub","date":"2008-03-03","kind":"publication","official_url":"https://pub.smpte.org/doc/st430-3/20080303-pub/","present_locally":true}],"pages":23,"scanned":false,"ocr":false}