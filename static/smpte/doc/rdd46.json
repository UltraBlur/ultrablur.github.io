le":"4.2.11 round function; ROUND(x)","page":13},{"level":3,"title":"4.2.12 SIGN(x)","page":13},{"level":2,"title":"4.3 General terms and definitions","page":14},{"level":3,"title":"4.3.1 Boolean","page":14},{"level":4,"title":"4.3.1.1 False","page":14},{"level":4,"title":"4.3.1.2 True","page":14},{"level":3,"title":"4.3.2 calendar day","page":14},{"level":3,"title":"4.3.3 DST daylight saving time","page":14},{"level":3,"title":"4.3.4 day-number","page":14},{"level":4,"title":"4.3.4.1 day-zero","page":15},{"level":3,"title":"4.3.5 DTAI","page":15},{"level":3,"title":"4.3.6 Julian Day Number JD","page":15},{"level":3,"title":"4.3.7 media unit","page":15},{"level":3,"title":"4.3.8 media block","page":15},{"level":3,"title":"4.3.9 media-index","page":15},{"level":3,"title":"4.3.10 midnight end-of-day midnight start-of-day midnight","page":15},{"level":3,"title":"4.3.11 Modified Julian Day MJD","page":16},{"level":3,"title":"4.3.12 phase-index","page":16},{"level":3,"title":"4.3.13 resolution, precision and accuracy","page":16},{"level":4,"title":"4.3.13.1 resolution","page":16},{"level":4,"title":"4.3.13.2 precision","page":16},{"level":4,"title":"4.3.13.3 accuracy","page":16}],"definitions":[{"term":"Boolean","definition":"binary variable, having two possible values called “True” and “False”"},{"term":"DST","definition":"daylight saving time"},{"term":"DTAI","definition":"value of the leap second offset as the difference between TAI and UTC"}],"keywords":[{"term":"SMPTE ST 12-1","zh":"时间码","abbr":"ST 12-1","category":"tv","source":"curated"},{"term":"PAL","zh":"PAL 制式","abbr":"","category":"tv","source":"curated"},{"term":"Precision Time Protocol","zh":"精确时间协议","abbr":"PTP","category":"ip","source":"curated"},{"term":"LTC","zh":"","abbr":"LTC","category":"other","source":"acronym"},{"term":"UTC","zh":"","abbr":"UTC","category":"other","source":"acronym"},{"term":"Boolean","zh":"","abbr":"","category":"other","source":"definition"}],"refs":[{"id":"st309","designation":