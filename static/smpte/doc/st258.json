{"id":"st258","designation":"ST 258","title":"Television - Transfer of Edit Decision Lists","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st258/","latest_url":"https://pub.smpte.org/latest/st258/","checked_at":"2026-11-11"},"scope":"This standard describes the data format for the interchange of a list of audio/video content decisions which specify an audio/video product. Exchange of this information allows the audio/video product to be reproduced on a compatible editing system. Such a list is commonly referred to as an edit decision list. The transfer medium and storage format are not specified in this standard.","outline":[],"definitions":[],"keywords":[{"term":"SMPTE ST 12-1","zh":"时间码","abbr":"ST 12-1","category":"tv","source":"curated"},{"term":"Edit Decision List","zh":"编辑决策表","abbr":"EDL","category":"metadata","source":"curated"},{"term":"SYNC","zh":"","abbr":"SYNC","category":"other","source":"acronym"},{"term":"ASCII","zh":"","abbr":"ASCII","category":"other","source":"acronym"},{"term":"AUDIO","zh":"","abbr":"AUDIO","category":"other","source":"acronym"},{"term":"NUMBER","zh":"","abbr":"NUMBER","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"rdd24","designation":"RDD 24"},{"id":"st2073-7","designation":"ST 2073-7"},{"id":"st2120-1","designation":"ST 2120-1"},{"id":"st2134","designation":"ST 2134"}],"versions":[{"version":"20040406-pub","date":"2004-04-06","kind":"publication","official_url":"https://pub.smpte.org/doc/st258/20040406-pub/","present_locally":true}],"pages":37,"scanned":false,"ocr":false}