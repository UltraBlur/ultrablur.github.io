{"id":"st424","designation":"ST 424","title":"3 Gb/s Signal/Data Serial Interface","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st424/","latest_url":"https://pub.smpte.org/latest/st424/","checked_at":"2026-11-18"},"scope":"This standard defines a bit-serial data structure and coaxial cable interface for the transport of signals with a total payload of 2.970 Gb/s or 2.970/1.001 Gb/s. This standard specifies the electrical and physical characteristics of a coaxial cable interface suitable for applications where the signal loss does not exceed an amount specified by the receiver manufacturer. Typical loss amounts would be in the range of up to 30 dB at one-half the clock frequency.","outline":[{"level":1,"title":"1","page":3},{"level":1,"title":"1 Scope","page":3},{"level":1,"title":"2 Conformance Notation","page":3},{"level":1,"title":"3 Normative References","page":3},{"level":1,"title":"4 Source Data","page":4},{"level":1,"title":"1","page":4},{"level":1,"title":"5 Parallel Data Format","page":4},{"level":1,"title":"6 Serial Data Format","page":4},{"level":1,"title":"7 Coaxial Cable Interface","page":5},{"level":1,"title":"Annex A Bibliography (Informative)","page":9},{"level":1,"title":"Annex B Channel Code (Informative)","page":10}],"definitions":[],"keywords":[{"term":"Connector","zh":"连接器","abbr":"","category":"tv","source":"curated"},{"term":"Test Pattern","zh":"测试图","abbr":"","category":"measurement","source":"curated"},{"term":"EAV","zh":"","abbr":"EAV","category":"other","source":"acronym"},{"term":"SAV","zh":"","abbr":"SAV","category":"other","source":"acronym"},{"term":"CRC","zh":"","abbr":"CRC","category":"other","source":"acronym"},{"term":"BNC","zh":"","abbr":"BNC","category":"other","source":"acronym"},{"term":"NRZI","zh":"","abbr":"NRZI","category":"other","source":"acronym"}],"refs":[{"id":"st425-1","designation":"ST 425-1"},{"id":"rp184","designation":"RP 184"},{"id":"st274","designation":"ST 274"},{"id":"st2