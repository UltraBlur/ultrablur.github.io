{"id":"st2046-1","designation":"ST 2046-1","title":"Safe Areas for Television — Specifications for Safe Action and Safe Title Areasfor Television","state":"active","suite":"2046","official":{"family_url":"https://pub.smpte.org/doc/st2046-1/","latest_url":"https://pub.smpte.org/latest/st2046-1/","checked_at":"2026-11-11"},"scope":"This Standard defines and specifies Safe Action and Safe Title Areas for 1920 x 1080, 1280 x 720, 720 x 576 and 720 x 480 television formats. This document is intended for application in program production where the image aspect ratio of the acquired essence is the same as that of the display. The safe areas defined in this Standard differ from past practice; they take into account changes in image acquisition, transmission and display technology. They do not offer guidance in situations where material generated in one aspect ratio may need to be displayed in a different aspect ratio.","outline":[{"level":1,"title":"SMPTE ST 2046-1:2009","page":1},{"level":1,"title":"Scope","page":3},{"level":1,"title":"Conformance Notation","page":3},{"level":1,"title":"Normative Reference","page":3},{"level":1,"title":"Definitions","page":4},{"level":2,"title":"Aspect Ratio","page":4},{"level":2,"title":"Image Lattice","page":4},{"level":2,"title":"Production Aperture","page":4},{"level":2,"title":"Safe Action Area","page":4},{"level":2,"title":"Safe Title Area","page":4},{"level":1,"title":"Specification of Safe Action Area and Safe Title Area","page":4},{"level":2,"title":"1080 Line Formats","page":5},{"level":2,"title":"720 Line Formats","page":5},{"level":2,"title":"576 Line Formats","page":5},{"level":2,"title":"480 Line Formats","page":5},{"level":1,"title":"Bibliography (Informative)","page":6},{"level":1,"title":"480-Line Format Image Lattice (Informative)","page":7},{"level":1,"title":"Safe Areas for Common Video Standards (Informative)","page":8},{"level":1,"title":"Table 3 – 1280 x 720, 16:9 aspect ratio, Progressive, (SMPTE 296M)","page":9},{"level":1,"title":"Table 4 - 525/59.94, 2:1 interlace (ANSI/SMPTE 125M, SMPTE RP 202)","page":9},{"level":1,"title":"Table 5 - 625/50, 2:1 interlace (ITU-R BT.656)","page":10},{"level":1,"title":"Graticules (Informative)","page":11}],"definitions":[],"keywords":[{"term":"Wide-Screen Scanning","zh":"宽银幕扫描","abbr":"","category":"film","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"CEA","zh":"","abbr":"CEA","category":"other","source":"acronym"}],"refs":[{"id":"rp218","designation":"RP 218"},{"id":"rp27-3","designation":"RP 27-3"},{"id":"rp2046-2","designation":"RP 2046-2"},{"id":"rp187","designation":"RP 187"},{"id":"rp202","designation":"RP 202"}],"cited_by":[{"id":"eg2046-3","designation":"EG 2046-3"},{"id":"rp2046-2","designation":"RP 2046-2"},{"id":"rp218","designation":"RP 218"}],"versions":[{"version":"20091123-pub","date":"2009-11-23","kind":"publication","official_url":"https://pub.smpte.org/doc/st2046-1/20091123-pub/","present_locally":true}],"pages":13,"scanned":false,"ocr":false}