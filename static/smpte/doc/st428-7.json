{"id":"st428-7","designation":"ST 428-7","title":"D-Cinema Distribution Master — Subtitle","state":"active","suite":"428","official":{"family_url":"https://pub.smpte.org/doc/st428-7/","latest_url":"https://pub.smpte.org/latest/st428-7/","checked_at":"2026-11-18"},"scope":"This document specifies the format of a DCDM Subtitle file. A DCDM Subtitle file contains a set of instructions for placing rendered text or graphical overlays at precise locations on distinct groups of motion picture frames. A DCDM Subtitle File is an integral component of a D-Cinema composition and may be present in Digital Cinema Package (DCP) file sets. Consequently, its design reflects features of other DCP file formats. The DCDM Subtitle file format is not intended for use in streaming applications.","outline":[],"definitions":[],"keywords":[{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"Mastering","zh":"母版制作","abbr":"","category":"mastering","source":"curated"},{"term":"Digital Cinema Distribution Master","zh":"数字影院发行母版","abbr":"DCDM","category":"cinema","source":"curated"},{"term":"UTF","zh":"","abbr":"UTF","category":"other","source":"acronym"},{"term":"PNG","zh":"","abbr":"PNG","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"eg428-23","designation":"EG 428-23"},{"id":"rdd52","designation":"RDD 52"},{"id":"rp428-22","designation":"RP 428-22"},{"id":"st2067-40","designation":"ST 2067-40"},{"id":"st2120-1","designation":"ST 2120-1"},{"id":"st429-2","designation":"ST 429-2"},{"id":"st429-5","designation":"ST 429-5"}],"versions":[{"version":"20140211-pub","date":"2014-02-11","kind":"publication","official_url":"https://pub.smpte.org/doc/st428-7/20140211-pub/","present_locally":true},{"version":"20101215-pub","date":"2010-1