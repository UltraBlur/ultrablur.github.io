{"id":"st429-5","designation":"ST 429-5","title":"D-Cinema Packaging — Timed Text Track File","state":"active","suite":"429","official":{"family_url":"https://pub.smpte.org/doc/st429-5/","latest_url":"https://pub.smpte.org/latest/st429-5/","checked_at":"2026-11-11"},"scope":"This standard specifies the format of a Generic Container (GC) for XML timed text and Timed Text Track File for the distribution of timed text content using MXF. The GC and Track File provide for carriage of an XML document and optional supporting resources such as images or fonts. Encryption is optionally available for protecting against unauthorized disclosure of the file contents. The standard defines data structures for interchange at the signal interfaces of networks or storage media, but does not define internal storage formats for compliant devices.","outline":[{"level":1,"title":"D-Cinema Packaging — Timed Text Track File","page":1},{"level":2,"title":"Table of contents","page":1},{"level":2,"title":"Foreword","page":1},{"level":2,"title":"Introduction","page":1},{"level":2,"title":"1Scope","page":1},{"level":2,"title":"2Conformance","page":1},{"level":2,"title":"3Normative references","page":1},{"level":2,"title":"4Terms and definitions","page":1},{"level":2,"title":"5Overview (informative)","page":1},{"level":2,"title":"6Ancillary Resource Wrapping","page":1},{"level":3,"title":"6.1Generic Stream Wrapper","page":1},{"level":3,"title":"6.2Generic Stream Repetition","page":1},{"level":3,"title":"6.3Indexing Generic Stream Data","page":1},{"level":2,"title":"7Mapping XML Timed Text to the MXF Generic Container","page":1},{"level":3,"title":"7.1Essence Encoding","page":1},{"level":3,"title":"7.2Index Table","page":1},{"level":3,"title":"7.3Timed Text Resource Constraints","page":1},{"level":3,"title":"7.4Header Metadata Construction","page":1},{"level":3,"title":"7.5Essence Descriptors","page":1},{"level":2,"title":"8Essence Encryption","page":1},{"level":2,"title":"9Synchronization","page":1},{"level":2,"title":"10Random Access to Ancillary Resources (informative)","page":1},{"level":2,"title":"11D-Cinema Timed Text Track File Structure","page":1},{"level":3,"title":"11.1Timed Text Track File Definition","page":1},{"level":3,"title":"11.2Exceptions to Provisions of SMPTE ST 429-3","page":1},{"level":3,"title":"11.3Generic Container","page":1},{"level":3,"title":"11.4Timed Text Resource","page":1},{"level":3,"title":"11.5Header Metadata Constraints","page":1},{"level":3,"title":"11.6Index Tables","page":1},{"level":2,"title":"Annex A Labels and Descriptor Sets (Normative)","page":1},{"level":3,"title":"A.1General","page":1},{"level":3,"title":"A.2Key UL Values","page":1},{"level":3,"title":"A.3TimedText Descriptor Set","page":1},{"level":3,"title":"A.4TimedTextResourceSubDescriptor Set","page":1},{"level":2,"title":"Bibliography","page":1}],"definitions":[],"keywords":[{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"Encryption","zh":"加密","abbr":"","category":"cinema","source":"curated"},{"term":"UUID","zh":"","abbr":"UUID","category":"other","source":"acronym"},{"term":"SOURCE","zh":"","abbr":"SOURCE","category":"other","source":"acronym"},{"term":"RIP","zh":"","abbr":"RIP","category":"other","source":"acronym"}],"refs":[{"id":"st429-3","designation":"ST 429-3"},{"id":"st377-1","designation":"ST 377-1"},{"id":"st379-1","designation":"ST 379-1"},{"id":"st379-2","designation":"ST 379-2"},{"id":"st410","designation":"ST 410"},{"id":"st429-6","designation":"ST 429-6"},{"id":"st428-7","designation":"ST 428-7"}],"