{"id":"rdd51","designation":"RDD 51","title":"High Density Image Encoding for ARRIRAW Files","state":"active","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/rdd51/","latest_url":"https://pub.smpte.org/latest/rdd51/","checked_at":"2026-11-18"},"scope":"This document describes the structure of data encoded with Codex High Density Image Encoding (HDE), along with algorithms for decoding the stored data. It is the intent of this RDD to describe the structure and encoding of all fields in the HDE bitstream, such that users of the RDD can develop applications to decode HDE bitstreams and correctly identify their structure. It is specifically not the intent of this document to support development of applications encoding or creating HDE bitstreams, or the implementation of file formats based on HDE bitstreams.","outline":[{"level":1,"title":"Introduction","page":3},{"level":1,"title":"1 Scope","page":4},{"level":1,"title":"2 References","page":4},{"level":1,"title":"3 Acronyms","page":4},{"level":1,"title":"4 Trademarks","page":4},{"level":1,"title":"5 Definition of Field Encoding Techniques","page":4},{"level":1,"title":"6 Definition of HDE bitstream","page":5},{"level":2,"title":"6.1 Bitstream Header","page":5},{"level":2,"title":"6.2 Plane Parameters","page":6},{"level":2,"title":"6.3 Row","page":7},{"level":3,"title":"6.3.1 Row Header","page":7},{"level":3,"title":"6.3.2 Group","page":8},{"level":1,"title":"7 Sample Size Indicator Table","page":10}],"definitions":[],"keywords":[{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"High Frame Rate","zh":"高帧率","abbr":"HFR","category":"cinema","source":"curated"},{"term":"RGB","zh":"","abbr":"RGB","category":"other","source":"acronym"},{"term":"ASCII","zh":"","abbr":"ASCII","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"rdd54","designation":"RDD 54"}],"versions":[{"version":"20200409-pub","date":"2020-04-09","kind":"publication",