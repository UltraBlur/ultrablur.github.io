{"id":"st297","designation":"ST 297","title":"Serial Digital Fiber Transmission System for SMPTE ST 259, SMPTE ST 344, SMPTE ST 292-1/2, SMPTE ST 424, SMPTE ST 2081-1 and SMPTE ST 2082-1 Signals","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st297/","latest_url":"https://pub.smpte.org/latest/st297/","checked_at":"2026-11-11"},"scope":"This standard defines an optical fiber system for transmitting bit-serial digital signals. It is intended for transmitting SMPTE ST 259 signals (143 through 360 Mb/s), SMPTE ST 344 signals (540Mb/s), SMPTE ST 292-1/2 signals (1.485 Gb/s and 1.485/1.001 Gb/s), SMPTE ST 424 signals (2.970 Gb/s and 2.970/1.001 Gb/s), SMPTE ST 2081-1 signals (5.940 Gb/s and 5.940/1.001 Gb/s) and SMPTE ST 2082-1 signals (11.88 Gb/s and 11.88/1.001 Gb/s).","outline":[],"definitions":[],"keywords":[{"term":"Connector","zh":"连接器","abbr":"","category":"tv","source":"curated"},{"term":"Fiber Optic","zh":"光纤","abbr":"","category":"tv","source":"curated"}],"refs":[{"id":"st259","designation":"ST 259"},{"id":"st344","designation":"ST 344"},{"id":"st292-1","designation":"ST 292-1"},{"id":"st424","designation":"ST 424"},{"id":"st2081-1","designation":"ST 2081-1"},{"id":"st2082-1","designation":"ST 2082-1"},{"id":"eg34","designation":"EG 34"},{"id":"rp178","designation":"RP 178"},{"id":"eg2069","designation":"EG 2069"}],"cited_by":[{"id":"eg2069","designation":"EG 2069"},{"id":"ov2082-0","designation":"OV 2082-0"},{"id":"ov425-0","designation":"OV 425-0"},{"id":"rp184","designation":"RP 184"},{"id":"rp192","designation":"RP 192"},{"id":"st292-2","designation":"ST 292-2"},{"id":"st297-1","designation":"ST 297-1"},{"id":"st297-2","designation":"ST 297-2"},{"id":"st424","designation":"ST 424"},{"id":"st425-2","designation":"ST 425-2"},{"id":"st425-4","designation":"ST 425-4"},{"id":"st425-6","designation":"ST 425-6"}],"versions":[{"version":"20150204-pub","date":"2015-02-04","kind":"publication","official_url":"https://pub.smpte.or