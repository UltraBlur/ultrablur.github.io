{"id":"st2022-3","designation":"ST 2022-3","title":"MPEG-2 Streams on IP Networks — Unidirectional Transport of Variable Bit Rate MPEG-2 Transport Streams on IP Networks","state":"stabilized","suite":"2022","official":{"family_url":"https://pub.smpte.org/doc/st2022-3/","latest_url":"https://pub.smpte.org/latest/st2022-3/","checked_at":"2026-11-18"},"scope":"This standard defines a transport protocol for the carriage of real-time piecewise constant variable bit rate (VBR) MPEG-2 Transport Streams over IP networks, either with or without Forward Error Correction for recovery from network transmission errors. A piecewise constant VBR transport stream can only vary at the PCRs of the program under consideration per ISO/IEC 13818-1:2018 § 2.4.2.3. This standard covers the encapsulation and transmission of MPEG-2 transport streams but does not cover other processes such as MPEG-2 encoding or multiplexing. The scope of this standard is shown in Figure 1. below. Figure 1 – SMPTE ST 2022-3 Scope Boundaries","outline":[{"level":1,"title":"SMPTE ST 2022-3:2019 Revision of ST 2022-3:2010","page":1},{"level":1,"title":"SMPTE ST 2022-3:2010","page":1},{"level":1,"title":"Foreword","page":2},{"level":1,"title":"Intellectual Property","page":2},{"level":1,"title":"Introduction","page":2},{"level":1,"title":"Scope","page":3},{"level":1,"title":"1 Conformance Notation","page":3},{"level":1,"title":"2 Normative References","page":4},{"level":1,"title":"3 Acronyms (Informative)","page":4},{"level":1,"title":"4 Terms and Definitions (Normative)","page":5},{"level":1,"title":"5 Transmission Protocols (Normative)","page":5},{"level":2,"title":"5.1 Relationship with other SMPTE ST 2022 Standards","page":5},{"level":2,"title":"5.2 TS Packets per Media Datagram","page":6},{"level":2,"title":"5.3 Timing Recovery","page":6},{"level":2,"title":"5.4 FEC Operation","page":6},{"level":3,"title":"5.4.1 Mode 1 operation","page":7},{"level":3,"title":"5.4.2 Mode 2 Operation","page":8},{"level":2,"title":"5.5 Media Datagram RTP Numbering","page":8},{"level":2,"title":"5.6 Session","page":9},{"level":1,"title":"6 Compliance","page":9},{"level":1,"title":"Annex A Bibliography (Informative)","page":12},{"level":1,"title":"Annex B Sending Device Options (Informative)","page":13},{"level":1,"title":"Annex C Clock Recovery Method (Informative)","page":14}],"definitions":[],"keywords":[{"term":"Video Compression","zh":"视频压缩","abbr":"","category":"tv","source":"curated"},{"term":"Real-time Transport Protocol","zh":"实时传输协议","abbr":"RTP","category":"ip","source":"curated"},{"term":"SMPTE ST 2022","zh":"ST 2022 IP 传输","abbr":"ST 2022","category":"ip","source":"curated"},{"term":"MPEG","zh":"","abbr":"MPEG","category":"other","source":"acronym"},{"term":"FEC","zh":"","abbr":"FEC","category":"other","source":"acronym"},{"term":"PCR","zh":"","abbr":"PCR","category":"other","source":"acronym"},{"term":"VBR","zh":"","abbr":"VBR","category":"other","source":"acronym"},{"term":"CBR","zh":"","abbr":"CBR","category":"other","source":"acronym"},{"term":"STD","zh":"","abbr":"STD","category":"other","source":"acronym"}],"refs":[{"id":"st2022-2","designation":"ST 2022-2"},{"id":"st2022-1","designation":"ST 2022-1"}],"cited_by":[{"id":"st2022-4","designation":"ST 2022-4"},{"id":"st2022-5","designation":"ST 2022-5"},{"id":"st2022-7","designation":"ST 2022-7"}],"versions":[{"version":"20190709-pub","date":"2019-07-09","kind":"publication","official_url":"https://pub.smpte.org/doc/st2022-3/20190709-pub/","present_locally":true},{"version":"20100430-pub","date":"2010-04-30","kind":"publication","official_url":"https://pub.smpte.org/doc/st2022-3/20100430-pub/","present_locally":true}],"pages":16,"scanned":false,"ocr":false}