{"id":"st429-9","designation":"ST 429-9","title":"D-Cinema Packaging — Asset Mapping and File Segmentation","state":"active","suite":"429","official":{"family_url":"https://pub.smpte.org/doc/st429-9/","latest_url":"https://pub.smpte.org/latest/st429-9/","checked_at":"2026-11-18"},"scope":"This document specifies a generic method of mapping asset identifiers (UUID) to locations (URI). An application of the method to common hierarchical filesystems, the Basic Map Profile v2, is specified. Note: Earlier versions of this specification allowed assets to be split among multiple volumes. This functionality was not found to be useful in practice and is removed from this version. The schema remains however unchanged to minimize impact on implementations.","outline":[],"definitions":[],"keywords":[{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Digital Control Interface","zh":"数字控制接口","abbr":"","category":"tv","source":"curated"},{"term":"UUID","zh":"","abbr":"UUID","category":"other","source":"acronym"},{"term":"UTF","zh":"","abbr":"UTF","category":"other","source":"acronym"}],"refs":[{"id":"st429-8","designation":"ST 429-8"}],"cited_by":[{"id":"st2067-2","designation":"ST 2067-2"},{"id":"st425-4","designation":"ST 425-4"}],"versions":[{"version":"20141124-pub","date":"2014-11-24","kind":"publication","official_url":"https://pub.smpte.org/doc/st429-9/20141124-pub/","present_locally":true},{"version":"20100321-am1-pub","date":"2010-03-21","kind":"amendment","official_url":"https://pub.smpte.org/doc/st429-9/20100321-am1-pub/","present_locally":true},{"version":"20070625-pub","date":"2007-06-25","kind":"publication","official_url":"https://pub.smpte.org/doc/st429-9/20070625-pub/","present_locally":true}],"pages":18,"scanned":false,"ocr":false}