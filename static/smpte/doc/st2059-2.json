{"id":"st2059-2","designation":"ST 2059-2","title":"Precision Time Protocol in Professional Broadcast Applications — SMPTE Profile for Use of IEEE-1588 Precision Time Protocol in Professional Broadcast Applications","state":"active","suite":"2059","official":{"family_url":"https://pub.smpte.org/doc/st2059-2/","latest_url":"https://pub.smpte.org/latest/st2059-2/","checked_at":"2026-11-18"},"scope":"This standard specifies a Precision Time Protocol profile specifically for the synchronization of audio/video equipment in a professional broadcast environment. The SMPTE PTP profile is based on IEEE Std 1588-2008 and includes a description of parameters, their default values, and permitted ranges.","outline":[{"level":1,"title":"1 Scope","page":4},{"level":1,"title":"2 Conformance Notation","page":4},{"level":1,"title":"3 Normative References","page":4},{"level":1,"title":"4 Definition of Terms and Acronyms","page":5},{"level":1,"title":"5 Byte Order","page":7},{"level":1,"title":"6 PTP Profile","page":7},{"level":2,"title":"6.1 Profile Identification","page":7},{"level":2,"title":"6.2 BMCA","page":7},{"level":2,"title":"6.3 Management Mechanism","page":7},{"level":2,"title":"6.4 Path Delay Measurement Mechanism","page":7},{"level":2,"title":"6.5 PTP Attribute Values","page":8},{"level":3,"title":"6.5.1 General","page":8},{"level":3,"title":"6.5.2 Configurable data set members","page":8},{"level":3,"title":"6.5.3 Dynamic data set members","page":9},{"level":3,"title":"6.5.4 Other attributes","page":10},{"level":3,"title":"6.5.5 Additional Enumerated Values","page":10},{"level":2,"title":"6.6 One-step and two-step Clocks","page":10},{"level":2,"title":"6.7 Clock Physical Requirements","page":11},{"level":3,"title":"6.7.1 Frequency accuracy","page":11},{"level":3,"title":"6.7.2 Frequency adjustment range","page":11},{"level":2,"title":"6.8 Node Types Required, Permitted or Prohibited","page":11},{"level":2,"title":"6.9 Transport Mechanisms Permitted","page":11},{"level":2,"title":"6.10 Communication Model","page":12},{"level":2,"title":"6.11 PTP Options","page":13},{"level":2,"title":"6.12 Organization Extension TLV: Synchronization Metadata","page":14},{"level":2,"title":"6.13 Setting dynamic SM TLV Values","page":18},{"level":3,"title":"6.13.1 General","page":18},{"level":3,"title":"6.13.2 Signaling a Time Jump event","page":19},{"level":3,"title":"6.13.3 Signaling the Daily Jam event","page":19},{"level":1,"title":"Annex A (Normative) Calculation of timeOfNextJam","page":21},{"level":1,"title":"Bibliography (Informative)","page":22}],"definitions":[{"term":"Daily Jam","definition":"optional daily procedure carried out within a facility that uses SMPTE ST 12-1 time code in which the time"},{"term":"FOLLOW state","definition":"state of a clock port that synchronizes to the device on the path with the port that is in the LEAD state"},{"term":"LEAD state","definition":"state of a clock port that is the source of time on the path served by the port"},{"term":"Local Time","definition":"time (and date) as chosen by the facility's system administrator and implemented by the system"},{"term":"PTP Domain","definition":"logical grouping of clocks that synchronize to each other using the Precision Time Protocol, but that are not"},{"term":"PTP epoch","definition":"origin of the timescale of a domain as defined in IEEE Std 1588-2008 (subclause 7.2.2)"},{"term":"PTP time","definition":"time elapsed since the PTP epoch as conveyed by the Precision Time Protocol as defined in IEEE Std 15882008 (subclause 7.2)"},{"term":"Synchronization signal","definition":"reference signal used for the synchronization of audio/video equipment in a professional broadcast"},{"term":"Time Jump","definition":"discontinuity in Local Time that is known in advance, caused typically by an adjustment to the number of"},{"term":"Configurable data set members","definition":"defaultDS.priority1"},{"term":"Dynamic data set members","definition":"portDS.logMinDelayReqInterval:"}],"keywords":[{"term":"Multicast","zh":"组播","abbr":"","category":"ip","source":"curated"},{"term":"Precision Time Protocol","zh":"精确时间协议","abbr":"PTP","category":"ip","source":"curated"},{"term":"IPR","zh":"","abbr":"IPR","category":"other","source":"acronym"},{"term":"UTC","zh":"","abbr":"UTC","category":"other","source":"acronym"},{"term":"Daily Jam","zh":"","abbr":"","category":"other","source":"definition"},{"term":"FOLLOW state","zh":"","abbr":"","category":"other","source":"definition"},{"term":"LEAD state","zh":"","abbr":"","category":"other","source":"definition"},{"term":"Local Time","zh":"","abbr":"","category":"other","source":"definition"},{"term":"PTP Domain","zh":"","abbr":"","category":"other","source":"definition"},{"term":"PTP epoch","zh":"","abbr":"","category":"other","source":"definition"},{"term":"PTP time","zh":"","abbr":"","category":"other","source":"definition"},{"term":"Synchronization signal","zh":"","abbr":"","category":"other","source":"definition"}],"refs":[{"id":"st2059-1","designation":"ST 2059-1"},{"id":"st12-1","designation":"ST 12-1"},{"id":"st309","designation":"ST 309"}],"cited_by":[{"id":"eg2059-10","designation":"EG 2059-10"},{"id":"eg2076-2","designation":"EG 2076-2"},{"id":"rdd46","designation":"RDD 46"},{"id":"rp2059-15","designation":"RP 2059-15"},{"id":"rp2076-1","designation":"RP 2076-1"},{"id":"st2059-1","designation":"ST 2059-1"},{"id":"st2110-10","designation":"ST 2110-10"},{"id":"st2134","designation":"ST 2134"}],"versions":[{"version":"20201209-pub","date":"2020-12-09","kind":"publication","official_url":"https://pub.smpte.org/doc/st2059-2/20201209-pub/","present_locally":true},{"version":"20150326-pub","date":"2015-03-26","kind":"publication","official_url":"https://pub.smpte.org/doc/st2059-2/20150326-pub/","present_locally":true}],"pages":22,"scanned":false,"ocr":false}