{"id":"st2101","designation":"ST 2101","title":"Format for Non-PCM Audio and Data in AES3 - AC-4 Data Type","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st2101/","latest_url":"https://pub.smpte.org/latest/st2101/","checked_at":"2026-11-18"},"scope":"This standard describes how AC-4 data rate reduced (non PCM) audio streams conforming to ETSI TS 103 190 are packed into an AES3 data stream, following the methods described by SMPTE ST 337. The AC-4 data type is identified by a data type number listed in SMPTE ST 338 and carried in the burst information word of the data burst preamble.","outline":[],"definitions":[],"keywords":[{"term":"AES3","zh":"AES3 数字音频","abbr":"AES3","category":"audio","source":"curated"},{"term":"Ultra High Definition","zh":"超高清","abbr":"UHD","category":"tv","source":"curated"},{"term":"Broadcast Exchange Format","zh":"广播交换格式","abbr":"BXF","category":"metadata","source":"curated"},{"term":"PCM","zh":"","abbr":"PCM","category":"other","source":"acronym"},{"term":"ETSI","zh":"","abbr":"ETSI","category":"other","source":"acronym"}],"refs":[{"id":"st2021","designation":"ST 2021"},{"id":"st337","designation":"ST 337"},{"id":"st338","designation":"ST 338"},{"id":"st274","designation":"ST 274"},{"id":"rp168","designation":"RP 168"},{"id":"st296","designation":"ST 296"},{"id":"st339","designation":"ST 339"},{"id":"st2036-1","designation":"ST 2036-1"},{"id":"st12-1","designation":"ST 12-1"}],"cited_by":[{"id":"st338","designation":"ST 338"}],"versions":[{"version":"20151106-pub","date":"2015-11-06","kind":"publication","official_url":"https://pub.smpte.org/doc/st2101/20151106-pub/","present_locally":true}],"pages":16,"scanned":false,"ocr":false}