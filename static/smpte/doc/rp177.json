{"id":"rp177","designation":"RP 177","title":"Derivation of Basic Television Color Equations","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/rp177/","latest_url":"https://pub.smpte.org/latest/rp177/","checked_at":"2026-11-18"},"scope":"This practice is intended to define the numerical procedures for deriving basic color equations for color television and other systems using additive display devices. These equations are first, the normalized reference primary matrix which defines the relationship between RGB signals and CIE tristimulus values XYZ; then, the system luminance equation; and finally, the color primary transformation matrix for transforming signals from one set of reference primaries to another set of reference primaries or to a set of display primaries.","outline":[],"definitions":[],"keywords":[{"term":"Chromaticity","zh":"色度","abbr":"","category":"measurement","source":"curated"},{"term":"Format Conversion","zh":"格式转换","abbr":"","category":"tv","source":"curated"},{"term":"RGB","zh":"","abbr":"RGB","category":"other","source":"acronym"},{"term":"CIE","zh":"","abbr":"CIE","category":"other","source":"acronym"},{"term":"XYZ","zh":"","abbr":"XYZ","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"rp176","designation":"RP 176"},{"id":"rp431-2","designation":"RP 431-2"},{"id":"st2036-1","designation":"ST 2036-1"},{"id":"st2048-1","designation":"ST 2048-1"},{"id":"st2065-1","designation":"ST 2065-1"},{"id":"st2067-21","designation":"ST 2067-21"},{"id":"st2073-3","designation":"ST 2073-3"},{"id":"st2085","designation":"ST 2085"},{"id":"st2094-20","designation":"ST 2094-20"},{"id":"st2113","designation":"ST 2113"},{"id":"st274","designation":"ST 274"},{"id":"st295","designation":"ST 295"},{"id":"st296","designation":"ST 296"},{"id":"st303","designation":"ST 303"}],"versions":[{"version":"19931101-pub","date":"1993-11-01","kind":"publication","official_url":"https://pub.smpte.org/doc/rp177/19931101-pub/",