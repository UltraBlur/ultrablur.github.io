{"id":"eg2046-3","designation":"EG 2046-3","title":"Safe Areas for Television — Safe Areas for Television","state":"active","suite":"2046","official":{"family_url":"https://pub.smpte.org/doc/eg2046-3/","latest_url":"https://pub.smpte.org/latest/eg2046-3/","checked_at":"2026-11-11"},"scope":"SMPTE has several Standards and Recommended Practices on safe areas for television. Among these are SMPTE ST 2046-1, SMPTE RP 2046-2, SMPTE RP 218, and SMPTE RP 27.3. It is the purpose of this Engineering Guideline to explain the use of these documents and the relationships among them and others, principally SMPTE ST 2016-1. A brief history of TV safe areas and their evolution is also given.","outline":[],"definitions":[],"keywords":[{"term":"Wide-Screen Scanning","zh":"宽银幕扫描","abbr":"","category":"film","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"Test Pattern","zh":"测试图","abbr":"","category":"measurement","source":"curated"},{"term":"Audio Description","zh":"口述影像","abbr":"AD","category":"accessibility","source":"curated"},{"term":"CEA","zh":"","abbr":"CEA","category":"other","source":"acronym"},{"term":"AFD","zh":"","abbr":"AFD","category":"other","source":"acronym"}],"refs":[{"id":"st2046-1","designation":"ST 2046-1"},{"id":"rp2046-2","designation":"RP 2046-2"},{"id":"rp218","designation":"RP 218"},{"id":"rp27-3","designation":"RP 27-3"},{"id":"st2016-1","designation":"ST 2016-1"}],"cited_by":[],"versions":[{"version":"20100223-pub","date":"2010-02-23","kind":"publication","official_url":"https://pub.smpte.org/doc/eg2046-3/20100223-pub/","present_locally":true}],"pages":8,"scanned":false,"ocr":false}