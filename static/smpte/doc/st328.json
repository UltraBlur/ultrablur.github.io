{"id":"st328","designation":"ST 328","title":"Television - MPEG-2 Video Elementary Stream Editing Information","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st328/","latest_url":"https://pub.smpte.org/latest/st328/","checked_at":"2026-11-18"},"scope":"This standard defines the MPEG video elementary stream (ES) information to facilitate seamless edits under defined circumstances. The video ES, as defined by the MPEG standards, is supplemented with additional information for professional studio applications. Supplementary information will be carried within the sequence header and the user data area of the video ES. This standard defines the data to be carried and the location of the data.","outline":[],"definitions":[],"keywords":[{"term":"SMPTE ST 12-1","zh":"时间码","abbr":"ST 12-1","category":"tv","source":"curated"},{"term":"NTSC","zh":"NTSC 制式","abbr":"","category":"tv","source":"curated"},{"term":"PAL","zh":"PAL 制式","abbr":"","category":"tv","source":"curated"},{"term":"MPEG","zh":"","abbr":"MPEG","category":"other","source":"acronym"},{"term":"GOP","zh":"","abbr":"GOP","category":"other","source":"acronym"},{"term":"HDTV","zh":"","abbr":"HDTV","category":"other","source":"acronym"},{"term":"SDTV","zh":"","abbr":"SDTV","category":"other","source":"acronym"},{"term":"PTS","zh":"","abbr":"PTS","category":"other","source":"acronym"},{"term":"DTS","zh":"","abbr":"DTS","category":"other","source":"acronym"}],"refs":[{"id":"rp202","designation":"RP 202"},{"id":"rp186","designation":"RP 186"},{"id":"rp210","designation":"RP 210"}],"cited_by":[{"id":"st331","designation":"ST 331"},{"id":"st381-2","designation":"ST 381-2"}],"versions":[{"version":"20000120-pub","date":"2000-01-20","kind":"publication","official_url":"https://pub.smpte.org/doc/st328/20000120-pub/","present_locally":true}],"pages":8,"scanned":false,"ocr":false}