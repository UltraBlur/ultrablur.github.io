{"id":"st2019-4","designation":"ST 2019-4","title":"VC-3 Video Compression — Mapping VC-3 Coding Units into the MXF Generic Container","state":"active","suite":"2019","official":{"family_url":"https://pub.smpte.org/doc/st2019-4/","latest_url":"https://pub.smpte.org/latest/st2019-4/","checked_at":"2026-11-11"},"scope":"This standard specifies the mapping of VC-3 Coding Units as a Picture Element that can be used in the Picture Item of the MXF GC. The Picture Element can contain either individual VC-3 Compressed Frames using frame-wrapping or a sequence of VC-3 Compressed Frames using clip-wrapping. The MXF Generic Container (GC) is described in SMPTE ST 379-1. VC-3 Coding Units and Compressed Frames are described in SMPTE ST 2019-1. This standard specifies the Key, the Length and the Value fields of the VC-3 Picture Element. This standard also defines the Essence Container and Compression Label values and the Essence Descriptor.","outline":[],"definitions":[],"keywords":[{"term":"Video Compression","zh":"视频压缩","abbr":"","category":"tv","source":"curated"},{"term":"Key-Length-Value","zh":"键-长度-值","abbr":"KLV","category":"metadata","source":"curated"},{"term":"IPR","zh":"","abbr":"IPR","category":"other","source":"acronym"},{"term":"RGB","zh":"","abbr":"RGB","category":"other","source":"acronym"},{"term":"RGBA","zh":"","abbr":"RGBA","category":"other","source":"acronym"},{"term":"CDCI","zh":"","abbr":"CDCI","category":"other","source":"acronym"}],"refs":[{"id":"st2019-1","designation":"ST 2019-1"},{"id":"st379-1","designation":"ST 379-1"},{"id":"st377-1","designation":"ST 377-1"},{"id":"st400","designation":"ST 400"},{"id":"rp224","designation":"RP 224"},{"id":"st298","designation":"ST 298"},{"id":"st336","designation":"ST 336"}],"cited_by":[{"id":"st2067-70","designation":"ST 2067-70"}],"versions":[{"version":"20240308-am1-pub","date":"2024-03-08","kind":"amendment","official_url":"https://pub.smpte.org/doc/st2019-4/20240308-am1-pub/","present_locally":true},{"version