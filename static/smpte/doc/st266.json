{"id":"st266","designation":"ST 266","title":"SD Digital Component Systems – Digital Vertical Interval Time Code","state":"stabilized","suite":null,"official":{"family_url":"https://pub.smpte.org/doc/st266/","latest_url":"https://pub.smpte.org/latest/st266/","checked_at":"2026-11-11"},"scope":"This standard defines the digital data representation of the digitized values of the Digital Vertical Interval (VITC) code words defined in SMPTE ST 12-1. The intended use is with the standard definition (SD) digital coding given in SMPTE ST 125 (for 525-line, 59.94-Hz field rate, SD Digital component signals) or Recommendation ITU-R BT.601-7 and Recommendation ITU-R BT.656 (for 625-line, 50-Hz field rate, SD Digital component signals).","outline":[{"level":1,"title":"1 Scope","page":3},{"level":1,"title":"2 Conformance Notation","page":3},{"level":1,"title":"3 Normative References","page":3},{"level":1,"title":"4 D-VITC General","page":4},{"level":2,"title":"4.1 Signal Definition","page":4},{"level":2,"title":"4.2 Data Assignment","page":4},{"level":2,"title":"4.3 Transitions","page":4},{"level":2,"title":"4.4 Digital Data","page":7},{"level":3,"title":"4.4.1 Data value associated with a logical one","page":7},{"level":3,"title":"4.4.2 Data value associated with a logical zero","page":7},{"level":3,"title":"4.4.3 Data value associated with transitions","page":7},{"level":3,"title":"4.4.4 Data value associated with unused luma sample positions","page":7},{"level":3,"title":"4.4.5 Data value associated with color difference sample positions","page":7},{"level":2,"title":"4.5 Insertion Lines","page":7}],"definitions":[],"keywords":[{"term":"SMPTE ST 12-1","zh":"时间码","abbr":"ST 12-1","category":"tv","source":"curated"},{"term":"EAV","zh":"","abbr":"EAV","category":"other","source":"acronym"},{"term":"SAV","zh":"","abbr":"SAV","category":"other","source":"acronym"},{"term":"VITC","zh":"","abbr":"VITC","category":"other","source":"acronym"},{"term":"SYNC","zh":"","abbr":"SYNC","cat