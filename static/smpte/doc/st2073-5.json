{"id":"st2073-5","designation":"ST 2073-5","title":"VC-5 Compression — Part 5: Layers","state":"stabilized","suite":"2073","official":{"family_url":"https://pub.smpte.org/doc/st2073-5/","latest_url":"https://pub.smpte.org/latest/st2073-5/","checked_at":"2026-11-11"},"scope":"This standard defines extensions to ST 2073-1 to support the representation of multiple images in a single VC-5 bitstream. Each of the individual images is called a layer. All layers present in the bitstream have the same width, height, number of channels, and image format. This standard defines mechanisms for representing stereo images, multiple exposure values, interlaced fields, and tiled images in a single bitstream. This standard is backward compatible such that a decoder that does not support these extensions will decode the first layer in the bitstream into a single displayable image.","outline":[{"level":1,"title":"1 Scope","page":4},{"level":1,"title":"2 Conformance Notation","page":4},{"level":1,"title":"3 Normative References","page":5},{"level":1,"title":"4 Terms and Definitions","page":5},{"level":2,"title":"4.1 Layers","page":5},{"level":1,"title":"5 Layer Syntax and Structure","page":5},{"level":2,"title":"5.1 Layer Overview","page":5},{"level":2,"title":"5.2 Bitstream Header","page":6},{"level":2,"title":"5.3 Layer Contents","page":6},{"level":2,"title":"5.4 Bitstream Layer Structure","page":7},{"level":2,"title":"5.5 Layer Codeblocks","page":7},{"level":1,"title":"6 Layer Codec State Parameters","page":7},{"level":2,"title":"6.1 Layer Count","page":7},{"level":2,"title":"6.2 Layer Number","page":7},{"level":2,"title":"6.3 Layer Pattern","page":7},{"level":2,"title":"6.4 Initial Codec State","page":8},{"level":2,"title":"6.5 Layer State Changes","page":8},{"level":1,"title":"7 Common Layer Patterns","page":8},{"level":2,"title":"7.1 Layer Pattern Overview (Informative)","page":8},{"level":2,"title":"7.2 Stereo Pairs","page":8},{"level":3,"title":"7.2.1 Organization of Stereo Layers","page":8},{"level":2,"title":"7.3 Multiple Video Streams","page":9},{"level":3,"title":"7.3.1 Definition of Multiple Video Stream","page":9},{"level":3,"title":"7.3.2 Organization of Layers for Multiple Video Streams","page":9},{"level":2,"title":"7.4 Interlaced Video","page":9},{"level":3,"title":"7.4.1 Organization of Interlaced Fields","page":9},{"level":2,"title":"7.5 Bracketed Exposure Images","page":9},{"level":3,"title":"7.5.1 Organization of Bracketed Exposure Images","page":9},{"level":2,"title":"7.6 Tiled Images","page":9},{"level":3,"title":"7.6.1 Organization of Layers for Tiled Images","page":9},{"level":3,"title":"7.6.2 Tiled Image Example (Informative)","page":10},{"level":2,"title":"7.7 Chroma Key","page":10},{"level":3,"title":"7.7.1 Organization of Layers for Chroma Key","page":10},{"level":3,"title":"7.7.2 Chroma Key Example (Informative)","page":10},{"level":1,"title":"8 Multiple Layer Patterns","page":10},{"level":1,"title":"Annex A Codec State Parameters","page":12},{"level":2,"title":"A.1 Bitstream Extensions","page":12},{"level":2,"title":"A.2 Parameter Descriptions","page":12},{"level":2,"title":"A.2.1 LayerCount","page":12},{"level":2,"title":"A.2.2 LayerNumber","page":12},{"level":2,"title":"A.2.3 LayerPattern","page":12},{"level":2,"title":"A.3 Tag-Value Pairs","page":13},{"level":1,"title":"Annex B Layer Compositing (Informative)","page":14},{"level":1,"title":"Bibliography (Informative)","page":15}],"definitions":[],"keywords":[{"term":"High Dynamic Range","zh":"高动态范围","abbr":"HDR","category":"hdr","source":"curated"},{"term":"Tone Mapping","zh":"色调映射","abbr":"","category":"hdr","source":"curated"},{"term":"RGB","zh":"","abbr":"RGB","category":"other","source":"acronym"}],"refs":[{"id":"st2073-1","designation":"ST 2073-1"},{"id":"st2073-3","designation":"ST 2073-3"},{"id":"st2073-4","designation":"ST 2073-4"},{"id":"st2073-6","designation":"ST 2073-6"}],"cited_by":[{"id":"ov2073-0","designation":"OV 2073-0"},{"id":"rp2073-2","design