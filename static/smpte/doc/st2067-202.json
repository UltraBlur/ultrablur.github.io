":2,"title":"8.3 Value","page":7},{"level":1,"title":"9 Essence Container Label and Essence Descriptor","page":7},{"level":2,"title":"9.1 Label for ISXD Essence Container Identification","page":7},{"level":2,"title":"9.2 ISXD Data Essence Descriptor","page":8},{"level":2,"title":"9.3 Label for ISXD Data Essence Coding","page":8},{"level":1,"title":"Annex A (Informative) Additional Elements","page":9}],"definitions":[{"term":"Constrained XML Document","definition":"well-formed and valid XML document as defined by W3C Extensible Markup Language (XML) 1.0 and as"}],"keywords":[{"term":"Interoperability","zh":"互操作性","abbr":"","category":"mastering","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Interoperable Master Format","zh":"可互操作母版格式","abbr":"IMF","category":"mastering","source":"curated"},{"term":"Composition Playlist","zh":"合成播放列表","abbr":"CPL","category":"cinema","source":"curated"},{"term":"LEAF","zh":"","abbr":"LEAF","category":"other","source":"acronym"},{"term":"Constrained XML Document","zh":"","abbr":"","category":"other","source":"definition"}],"refs":[{"id":"st377-1","designation":"ST 377-1"},{"id":"st379-2","designation":"ST 379-2"},{"id":"st429-17","designation":"ST 429-17"},{"id":"rp2057","designation":"RP 2057"},{"id":"st2067-2","designation":"ST 2067-2"},{"id":"st2067-3","designation":"ST 2067-3"},{"id":"st2067-5","designation":"ST 2067-5"}],"cited_by":[],"versions":[{"version":"20221124-pub","date":"2022-11-24","kind":"publication","official_url":"https://pub.smpte.org/doc/st2067-202/20221124-pub/","present_locally":true}],"pages":9,"scanned":false,"ocr":false}