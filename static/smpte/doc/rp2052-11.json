{"id":"rp2052-11","designation":"RP 2052-11","title":"Timed Text Format (SMPTE-TT) — Conversion from CEA-708 Caption Data to SMPTE-TT","state":"stabilized","suite":"2052","official":{"family_url":"https://pub.smpte.org/doc/rp2052-11/","latest_url":"https://pub.smpte.org/latest/rp2052-11/","checked_at":"2026-11-18"},"scope":"This document defines the preferred method of converting from CEA-708 data as defined in CEA-708 into SMPTE-TT (as defined in SMPTE ST 2052-1). This document details how such a conversion can be made, and defines some constraints on the process so that the resulting SMPTE-TT file is interoperable between SMPTE-TT implementations.","outline":[],"definitions":[],"keywords":[{"term":"Interoperability","zh":"互操作性","abbr":"","category":"mastering","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"AVC","zh":"AVC/H.264","abbr":"","category":"tv","source":"curated"},{"term":"CEA","zh":"","abbr":"CEA","category":"other","source":"acronym"}],"refs":[{"id":"rp2052-10","designation":"RP 2052-10"},{"id":"st2052-1","designation":"ST 2052-1"}],"cited_by":[{"id":"ov2052-0","designation":"OV 2052-0"},{"id":"st2067-2","designation":"ST 2067-2"}],"versions":[{"version":"20130605-pub","date":"2013-06-05","kind":"publication","official_url":"https://pub.smpte.org/doc/rp2052-11/20130605-pub/","present_locally":true}],"pages":23,"scanned":false,"ocr":false}