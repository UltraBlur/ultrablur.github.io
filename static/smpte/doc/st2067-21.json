{"id":"st2067-21","designation":"ST 2067-21","title":"Interoperable Master Format (IMF) — Application #2E","state":"active","suite":"2067","official":{"family_url":"https://pub.smpte.org/doc/st2067-21/","latest_url":"https://pub.smpte.org/latest/st2067-21/","checked_at":"2026-11-11"},"scope":"This specification defines IMF Application #2E. It is a specialization of the IMF Framework. Application #2E is meant for studio applications where a TV or movie title is transformed into multiple content versions (airline edits, special edition, languages...) that are made available to multiple consumer distribution channels (Internet, optical media, broadcast...) across multiple territories and over the span of many months to over a year. It uses image essence coded as a JPEG 2000 codestream and audio essence coded as linear PCM.","outline":[],"definitions":[],"keywords":[{"term":"Interoperability","zh":"互操作性","abbr":"","category":"mastering","source":"curated"},{"term":"Chromaticity","zh":"色度","abbr":"","category":"measurement","source":"curated"},{"term":"Transfer Function","zh":"传递函数","abbr":"","category":"measurement","source":"curated"},{"term":"Ultra High Definition","zh":"超高清","abbr":"UHD","category":"tv","source":"curated"},{"term":"High Dynamic Range","zh":"高动态范围","abbr":"HDR","category":"hdr","source":"curated"},{"term":"Interoperable Master Format","zh":"可互操作母版格式","abbr":"IMF","category":"mastering","source":"curated"},{"term":"Mastering","zh":"母版制作","abbr":"","category":"mastering","source":"curated"},{"term":"Hybrid Log-Gamma","zh":"混合对数伽马","abbr":"HLG","category":"hdr","source":"curated"},{"term":"ITU-R BT.2100","zh":"BT.2100","abbr":"BT.2100","category":"hdr","source":"curated"},{"term":"Perceptual Quantizer","zh":"感知量化","abbr":"PQ","category":"hdr","source":"curated"},{"term":"JPEG 2000","zh":"JPEG 2000","abbr":"J2K","category":"cinema","source":"curated"},{"term":"Mastering Display","zh":"母版显示器","abbr":"","category":"hdr","source":"curated"}],"refs":[{"id":"s