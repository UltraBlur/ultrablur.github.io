{"id":"st334-1","designation":"ST 334-1","title":"Caption — Vertical Ancillary Data Mapping of Caption Data and Other Related Data","state":"stabilized","suite":"334","official":{"family_url":"https://pub.smpte.org/doc/st334-1/","latest_url":"https://pub.smpte.org/latest/st334-1/","checked_at":"2026-11-18"},"scope":"This standard defines a method of mapping closed captioning and certain other related data services into the 10-bit vertical ancillary (“VANC”) data space. It specifies the structure of packets carrying CEA-708, as well as CEA-608 closed captioning data, time code data, and ATSC A/65 closed caption descriptor information, which may be carried in vertical ancillary data space, via serial data communications interfaces, or via other means. The related data services include data broadcast services intended for the public as well as broadcaster internal control and communications.","outline":[],"definitions":[],"keywords":[{"term":"Ancillary Data","zh":"辅助数据","abbr":"","category":"tv","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"NTSC","zh":"NTSC 制式","abbr":"","category":"tv","source":"curated"},{"term":"Vertical Blanking Interval","zh":"场消隐期","abbr":"","category":"tv","source":"curated"},{"term":"VANC","zh":"","abbr":"VANC","category":"other","source":"acronym"},{"term":"ANC","zh":"","abbr":"ANC","category":"other","source":"acronym"},{"term":"DID","zh":"","abbr":"DID","category":"other","source":"acronym"},{"term":"SDID","zh":"","abbr":"SDID","category":"other","source":"acronym"},{"term":"UDW","zh":"","abbr":"UDW","category":"other","source":"acronym"},{"term":"ADF","zh":"","abbr":"ADF","category":"other","source":"acronym"},{"term":"VBI","zh":"","abbr":"VBI","category":"other","source":"acronym"},{"term":"SDTV","zh":"","abbr":"SDTV","category":"other","source":"acronym"}],"refs":[{"id":"st334-2","designation":"ST 334-2"},{"id":"rp2007","designation":"RP 2007"},{"id":"eg43",