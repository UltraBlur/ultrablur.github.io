e Real-Time"},{"term":"Sender","definition":"subsystem within a device which originates one RTP stream (or redundant set of streams) into the Network"},{"term":"Receiver","definition":"subsystem within a device which terminates one RTP stream (or redundant set of streams) from the"},{"term":"Big-Endian Byte Order","definition":"convention for the transport ordering of octets within values which require more than one octet to represent,"},{"term":"Standard UDP Size Limit","definition":"maximum limit on the size of the UDP portion of the IP datagrams when operating in the size range specified"},{"term":"Extended UDP Size Limit","definition":"maximum limit on the size of the UDP portion of the IP datagrams when operating in the size range specified"},{"term":"Image Sampling Instant","definition":"time instant representative of the scene capture time"},{"term":"RTP Timestamp","definition":"data field specified as “timestamp” in IETF RFC 3550 section 5.1 titled “RTP Fixed Header Fields”"},{"term":"Media Clock","definition":"timebase related to the sampling rate (or frame rate in the case of video) of the media within the stream,"},{"term":"RTP Clock","definition":"counter advanced by the Media Clock at the rate specified for the media type, and which is sampled to"},{"term":"Common Reference Clock","definition":"network-delivered clock that can be used for synchronization of stream contents across different Devices"}],"keywords":[{"term":"Archiving","zh":"归档","abbr":"","category":"archive","source":"curated"},{"term":"Real-time Transport Protocol","zh":"实时传输协议","abbr":"RTP","category":"ip","source":"curated"},{"term":"Session Description Protocol","zh":"会话描述协议","abbr":"SDP","category":"ip","source":"curated"},{"term":"Multicast","zh":"组播","abbr":"","category":"ip","source":"curated"},{"term":"SMPTE ST 2110","zh":"ST 2110 专业媒体 IP","abbr":"ST 2110","category":"ip","source":"curated"},{"term":"SMPTE ST 2022","zh":"ST 2022 IP 传输","abbr":"ST 2022","category":"ip","source":"cu