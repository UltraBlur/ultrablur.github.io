{"id":"st429-7","designation":"ST 429-7","title":"D-Cinema Packaging — Composition Playlist","state":"active","suite":"429","official":{"family_url":"https://pub.smpte.org/doc/st429-7/","latest_url":"https://pub.smpte.org/latest/st429-7/","checked_at":"2026-11-11"},"scope":"This document specifies the Composition Playlist structure. The Composition Playlist is a self-contained representation of a single complete D-Cinema work, such as a motion picture, or a trailer, or an advertisement, etc. The Composition Playlist consists of an ordered sequence of Reel structures, each referencing a set of external Track Files, e.g. a sound or picture Track File, which are meant to be reproduced in parallel. Each Reel is analogous to a film reel and the Composition Playlist controls the order and timing of the playout of the Reels.","outline":[],"definitions":[],"keywords":[{"term":"Tape Reels and Cassettes","zh":"磁带盘与卡带","abbr":"","category":"tv","source":"curated"},{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"Mastering","zh":"母版制作","abbr":"","category":"mastering","source":"curated"},{"term":"Composition Playlist","zh":"合成播放列表","abbr":"CPL","category":"cinema","source":"curated"},{"term":"UUID","zh":"","abbr":"UUID","category":"other","source":"acronym"},{"term":"MIME","zh":"","abbr":"MIME","category":"other","source":"acronym"},{"term":"URN","zh":"","abbr":"URN","category":"other","source":"acronym"}],"refs":[],"cited_by":[{"id":"rdd52","designation":"RDD 52"},{"id":"st2067-40","designation":"ST 2067-40"},{"id":"st2120-1","designation":"ST 2120-1"},{"id":"st429-10","designation":"ST 429-10"},{"id":"st429-14","designation":"ST 42