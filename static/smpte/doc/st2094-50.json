{"id":"st2094-50","designation":"ST 2094-50","title":"Dynamic Metadata for Color Volume Transform — Application #5","state":"active","suite":"2094","official":{"family_url":"https://pub.smpte.org/doc/st2094-50/","latest_url":"https://pub.smpte.org/latest/st2094-50/","checked_at":"2026-11-18"},"scope":"This standard specifies the metadata for the Color Volume Transform Application #5. It is a specialization of the content-dependent transform metadata entries and processing blocks of the generalized color volume transform model defined in SMPTE ST 2094-1:2016. It includes parameters for conversion of an input image essence to a common relative linear color space, parameters for a headroom-adaptive tone mapping algorithm, and the mathematical definition of that headroom-adaptive tone mapping algorithm.","outline":[],"definitions":[],"keywords":[{"term":"Chromaticity","zh":"色度","abbr":"","category":"measurement","source":"curated"},{"term":"Ultra High Definition","zh":"超高清","abbr":"UHD","category":"tv","source":"curated"},{"term":"High Dynamic Range","zh":"高动态范围","abbr":"HDR","category":"hdr","source":"curated"},{"term":"Hybrid Log-Gamma","zh":"混合对数伽马","abbr":"HLG","category":"hdr","source":"curated"},{"term":"ITU-R BT.2100","zh":"BT.2100","abbr":"BT.2100","category":"hdr","source":"curated"},{"term":"SMPTE ST 2094","zh":"动态元数据","abbr":"ST 2094","category":"hdr","source":"curated"},{"term":"Color Volume Transform","zh":"色彩体积变换","abbr":"CVT","category":"hdr","source":"curated"},{"term":"Electro-Optical Transfer Function","zh":"电光转换函数","abbr":"EOTF","category":"measurement","source":"curated"},{"term":"Tone Mapping","zh":"色调映射","abbr":"","category":"hdr","source":"curated"},{"term":"IPR","zh":"","abbr":"IPR","category":"other","source":"acronym"},{"term":"CIE","zh":"","abbr":"CIE","category":"other","source":"acronym"},{"term":"REC","zh":"","abbr":"REC","category":"other","source":"acronym"}],"refs":[{"id":"st2094-1","designation":"ST 2094-1"},{"id":"st2113","designation"