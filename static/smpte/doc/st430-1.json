{"id":"st430-1","designation":"ST 430-1","title":"D-Cinema Operations — Key Delivery Message","state":"active","suite":"430","official":{"family_url":"https://pub.smpte.org/doc/st430-1/","latest_url":"https://pub.smpte.org/latest/st430-1/","checked_at":"2026-11-18"},"scope":"This specification defines a Key Delivery Message (KDM) for use in Digital Cinema (D-Cinema) systems. The KDM has been designed to deliver security parameters and usage rights between D-Cinema content processing centers (e.g., from post production to distribution, or from distribution to exhibition). The KDM carries fundamentally three information types: content keys for a specified Composition Playlist (CPL), content key parameters – primarily the permitted key usage date/time window, and the Trusted Device List (TDL), which identifies equipment permitted to use the content keys. The KDM is based on the D-Cinema Generic Extra-Theater Message (ETM) format (SMPTE ST 430-3). It uses XML to represent the information about the content keys and TDLs, and provides security using standardized XML encryption and signature primitives. The KDM message uses X.509 digital certificates, specified in SMPTE ST 430-2, to provide authentication and trust.","outline":[{"level":1,"title":"D-Cinema Operations — Key Delivery Message","page":1},{"level":2,"title":"Table of contents","page":1},{"level":2,"title":"Foreword","page":1},{"level":2,"title":"1Scope","page":1},{"level":2,"title":"2Conformance","page":1},{"level":2,"title":"3Normative references","page":1},{"level":2,"title":"4Terms and definitions","page":1},{"level":2,"title":"5Overview of the KDM (Informative)","page":1},{"level":3,"title":"5.1Basic KDM Elements and D-Cinema Relationships","page":1},{"level":3,"title":"5.2XML Overview of the KDM","page":1},{"level":2,"title":"6Authenticated and Unencrypted Information","page":1},{"level":3,"title":"6.1Overview","page":1},{"level":3,"title":"6.2MessageType","page":1},{"level":3,"title":"6.3RequiredExtensions","page":1},{"level":3,"title":"6.4NonCriticalExtensions","page":1},{"level":2,"title":"7Authenticated and Encrypted Information","page":1},{"level":3,"title":"7.1Overview","page":1},{"level":3,"title":"7.2EncryptedKey","page":1},{"level":3,"title":"7.3EncryptedData","page":1},{"level":2,"title":"8Signature Information","page":1},{"level":2,"title":"Annex A Design Features and Security Goals (Informative)","page":1},{"level":2,"title":"Annex B XML Schema for KDM (Normative)","page":1},{"level":2,"title":"Bibliography","page":1}],"definitions":[],"keywords":[{"term":"Digital Cinema Package","zh":"数字影院包","abbr":"DCP","category":"cinema","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"SMPTE ST 429","zh":"D-Cinema 打包","abbr":"ST 429","category":"cinema","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"Encryption","zh":"加密","abbr":"","category":"cinema","source":"curated"},{"term":"Composition Playlist","zh":"合成播放列表","abbr":"CPL","category":"cinema","source":"curated"},{"term":"Forensic Marking","zh":" forensic 标记","abbr":"","category":"cinema","source":"curated"},{"term":"Key Delivery Message","zh":"密钥分发消息","abbr":"KDM","category":"cinema","source":"curated"},{"term":"UUID","zh":"","abbr":"UUID","category":"other","source":"acronym"},{"term":"SOURCE","zh":"","abbr":"SOURCE","category":"other","source":"acronym"},{"term":"UTC","zh":"","abbr":"UTC","category":"other","source":"acronym"}],"refs":[{"id":"st430-3","designation":"ST 430-3"},{"id":"st430-2","designation":"ST 430-2"},{"id":"st429-6","designation":"ST 429-6"},{"id":"st429-7","designation":"ST 429-7"},{"id":"st429-14","designation":"ST 429-14"}],"cited_by":[{"id":"st429-2","designation":"ST 429-2"},{"id":"st429-6","designation":"ST 429-6"},{"id":"st430-15","designation":"ST 430-15"},{"id":"st430-16","designation":"ST 430-16"},{"id":"st430-17","designation":"ST