{"id":"st2052-1","designation":"ST 2052-1","title":"Timed Text Format (SMPTE-TT) — Timed Text Format (SMPTE-TT)","state":"stabilized","suite":"2052","official":{"family_url":"https://pub.smpte.org/doc/st2052-1/","latest_url":"https://pub.smpte.org/latest/st2052-1/","checked_at":"2026-11-11"},"scope":"This Standard defines the SMPTE profile of W3C Timed Text Markup Language (TTML), designated SMPTE- TT, which may represent Captions or Subtitles. It identifies the features from TTML required for interoperability between display systems for the format. In order to preserve certain semantic features of the input formats, SMPTE-TT also defines some standard metadata terms to be used, and some extension features not found in TTML.","outline":[],"definitions":[],"keywords":[{"term":"Interoperability","zh":"互操作性","abbr":"","category":"mastering","source":"curated"},{"term":"Extensible Markup Language","zh":"可扩展标记语言","abbr":"XML","category":"metadata","source":"curated"},{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"Subtitles","zh":"字幕","abbr":"","category":"accessibility","source":"curated"},{"term":"Archiving","zh":"归档","abbr":"","category":"archive","source":"curated"},{"term":"CEA","zh":"","abbr":"CEA","category":"other","source":"acronym"},{"term":"DVB","zh":"","abbr":"DVB","category":"other","source":"acronym"},{"term":"MIME","zh":"","abbr":"MIME","category":"other","source":"acronym"},{"term":"PNG","zh":"","abbr":"PNG","category":"other","source":"acronym"}],"refs":[{"id":"st334-2","designation":"ST 334-2"}],"cited_by":[{"id":"ov2052-0","designation":"OV 2052-0"},{"id":"rp2052-10","designation":"RP 2052-10"},{"id":"rp2052-11","designation":"RP 2052-11"},{"id":"st2067-5","designation":"ST 2067-5"}],"versions":[{"version":"20130605-pub","date":"2013-06-05","kind":"publication","official_url":"https://pub.smpte.org/doc/st2052-1/20130605-pub/","present_locally":true},{"version":"20101203-pub","date":"2010-12-03