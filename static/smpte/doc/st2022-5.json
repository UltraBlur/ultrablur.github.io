{"id":"st2022-5","designation":"ST 2022-5","title":"MPEG-2 Streams on IP Networks — Forward Error Correction for Transport of High Bit Rate Media Signals over IP Networks (HBRMT)","state":"active","suite":"2022","official":{"family_url":"https://pub.smpte.org/doc/st2022-5/","latest_url":"https://pub.smpte.org/latest/st2022-5/","checked_at":"2026-11-11"},"scope":"This Standard defines a forward error correction technique for the carriage of High Bit Rate real-time media over IP networks. The term High Bit Rate is used herein to distinguish from other Media-over-IP applications in which primarily compressed signals are transported; the FEC system described herein is differentiated by an ability to accommodate media payloads at rates of 270 Mbits/sec and higher.","outline":[{"level":1,"title":"1 Scope","page":4},{"level":1,"title":"2 Conformance Notation","page":4},{"level":1,"title":"3 Normative Reference","page":4},{"level":1,"title":"Acronyms (Informative)","page":5},{"level":1,"title":"Definitions (Normative)","page":5},{"level":1,"title":"6 FEC Datagram Structure","page":6},{"level":2,"title":"6.1 Datagram Structure","page":6},{"level":2,"title":"6.2 RTP Header for FEC Datagrams","page":7},{"level":1,"title":"7 FEC scheme","page":8},{"level":2,"title":"7.1 FEC Datagram Arrangement","page":8},{"level":2,"title":"7.2 FEC Buffer Overhead and Latency Implications","page":10},{"level":2,"title":"7.3 FEC Header Format","page":10},{"level":2,"title":"7.4 Construction of FEC Datagrams","page":12},{"level":3,"title":"7.4.1 Construction of FEC Header","page":13},{"level":3,"title":"7.4.2 Construction of FEC Payload","page":13},{"level":2,"title":"7.5 FEC Traffic Shaping Issues","page":14},{"level":2,"title":"7.6 Re-Order Tolerance (Informative)","page":14}],"definitions":[],"keywords":[{"term":"Closed Captioning","zh":"隐藏字幕","abbr":"CC","category":"accessibility","source":"curated"},{"term":"Real-time Transport Protocol","zh":"实时传输协议","abbr":"RTP","category":"ip","source":"